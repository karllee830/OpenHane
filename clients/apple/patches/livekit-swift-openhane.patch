+/// Decides whether to trust a server presenting `trust` for `host`. Called on a background queue.
+public typealias ServerTrustEvaluator = @Sendable (_ trust: SecTrust, _ host: String) -> Bool
+
+/// Shared handling of `NSURLAuthenticationMethodServerTrust` challenges.
+enum ServerTrustChallenge {
+    static func handle(_ challenge: URLAuthenticationChallenge,
+                       evaluator: ServerTrustEvaluator?,
+                       completionHandler: @escaping (URLSession.AuthChallengeDisposition, URLCredential?) -> Void)
+    {
+        guard let evaluator,
+              challenge.protectionSpace.authenticationMethod == NSURLAuthenticationMethodServerTrust,
+              let trust = challenge.protectionSpace.serverTrust
+        else {
+            completionHandler(.performDefaultHandling, nil)
+            return
+        }
+        if evaluator(trust, challenge.protectionSpace.host) {
+            completionHandler(.useCredential, URLCredential(trust: trust))
+        } else {
+            completionHandler(.cancelAuthenticationChallenge, nil)
+        }
+    }
+}
